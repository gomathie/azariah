# Azaria environment sample. Placeholders only: never commit real values.
# Copy this file to `.env` (gitignored) and fill it in. It is the only env file the project uses.

# 1. Local development -------------------------------------------------------
# Read by `npm run dev`, `npm run build` and the tests. Values from `npx supabase status`.
# Keep these on the local stack; never point them at the cloud project.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Default language of the app: en | fr | tw
VITE_DEFAULT_LOCALE=en


# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-cloud-publishable-key
# VITE_DEFAULT_LOCALE=en
# NODE_VERSION=22.18.0

# 3. Supabase Edge Function secrets (Azaria Plus payments) --------------------
# Used only by the functions in supabase/functions, never by the browser.
# Local trial:  npx supabase functions serve --env-file .env
# Cloud:        npx supabase secrets set PAYSTACK_SECRET_KEY=... APP_URL=... --project-ref <ref>
# Paystack dashboard > Settings > API Keys & Webhooks. Test key starts sk_test_, live key sk_live_.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
# The app's public address, no slash at the end. Production: your Cloudflare Pages address.
APP_URL=http://localhost:5173
